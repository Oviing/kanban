PORT=3000
DATABASE_URL=postgres://kanban:kanban@localhost:5432/kanban
# Public base URL users reach this service at (used for OIDC redirect URI: <PUBLIC_URL>/auth/callback)
PUBLIC_URL=http://localhost:3000
# >= 32 random chars: openssl rand -hex 32
SESSION_SECRET=change-me-change-me-change-me-change-me

# OpenID Connect (any compliant provider)
OIDC_ISSUER=http://localhost:8080/realms/kanban
OIDC_CLIENT_ID=kanban-web
# Leave empty for a public client (PKCE only)
OIDC_CLIENT_SECRET=
# Expected `aud` in agent access tokens. Strongly recommended in production.
OIDC_AUDIENCE=kanban
# Comma-separated emails that become admins on login (email must be verified by the IdP)
OIDC_ADMIN_EMAILS=
# Only for local dev with an http:// issuer
OIDC_ALLOW_INSECURE=true
# Minutes an agent claim stays valid without activity before others may take the task over
LEASE_MINUTES=30

# ---- No-auth mode (local / private network only) ----
# AUTH_MODE=none            # skips OIDC entirely; everything below OIDC_* is then ignored
# HOST=127.0.0.1            # none-mode default; anything else also needs ALLOW_NO_AUTH_REMOTE=true
# ALLOW_NO_AUTH_REMOTE=false
# DATA_DIR=./data           # embedded database location when DATABASE_URL is unset
# ALLOWED_HOSTS=            # extra host[:port] values to accept, comma-separated
