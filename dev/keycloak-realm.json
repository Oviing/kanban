{
  "realm": "kanban",
  "enabled": true,
  "clientScopes": [
    {
      "name": "kanban-audience",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "kanban-aud",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "kanban", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "kanban-web",
      "secret": "dev-web-secret",
      "publicClient": false,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:3000/auth/callback"],
      "webOrigins": ["http://localhost:3000"],
      "defaultClientScopes": ["openid", "profile", "email"]
    },
    {
      "clientId": "demo-agent",
      "secret": "dev-agent-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["kanban-audience"]
    }
  ],
  "users": [
    { "username": "alice", "email": "alice@example.com", "emailVerified": true, "enabled": true, "firstName": "Alice", "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }] }
  ]
}
